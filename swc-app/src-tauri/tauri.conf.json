{
  "$schema": "https://raw.githubusercontent.com/nicbarker/tauri/refs/heads/v2/crates/tauri-utils/schema.json",
  "productName": "SWC Toolbox",
  "version": "0.1.0",
  "identifier": "com.swc-toolbox",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "build-frontend.cmd"
  },
  "bundle": {
    "targets": ["nsis"],
    "active": true,
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "SWC Toolbox - 水土保持工具箱",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "opener": {}
  }
}
